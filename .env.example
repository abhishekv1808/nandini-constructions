# Public site URL (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2). Without these, site-config falls back to visibly marked [CONFIRM] placeholders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to serve /dev/* preview pages in a production build.
ENABLE_DEV_PAGES=
